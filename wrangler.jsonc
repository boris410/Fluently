{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluently",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://fluently.persional-etutor.workers.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fluently_db",
      "database_id": "e8c5ca8c-bb85-4c47-9111-ad4db611f9ef",
      "migrations_dir": "migrations"
    }
  ]
}
